+// `.group` is a marker class, tailwind emits no rule for it — the className string is
+// the only place it exists. A group publishes its state for descendants to match on.
+const GroupProvider = ({ state, children }: { state: PressableStateCallbackType; children: ReactNode }) => {
+    const uniwindContext = useUniwindContext()
+    const { pressed, focused, hovered } = state as PressableStateCallbackType & { hovered?: boolean }
+    const value = useMemo(() => ({
+        ...uniwindContext,
+        groupAttrs: {
+            'data-group-pressed': pressed || undefined,
+            'data-group-focused': focused || undefined,
+            'data-group-hovered': hovered || undefined,
+        },
+    }), [uniwindContext, pressed, focused, hovered])
+
+    return <UniwindContext.Provider value={value}>{children}</UniwindContext.Provider>
+}
