		"@expo/html-elements": "^57.0.0",
		"@legendapp/list": "^3.3.3",
		"@material-symbols/svg-400": "^0.44.9",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@tanstack/react-query": "^5.100.14",
